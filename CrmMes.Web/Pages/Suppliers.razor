@page "/fornitori"
@inject Api Api
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Fornitori · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Acquisti</div>
        <h1>Fornitori</h1>
        <p class="sub">Fornitori e terzisti, con ordini e listino.</p>
    </div>
    @if (CanCreate)
    {
        <div class="actions">
            <button class="secondary" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Chiudi nuovo fornitore" : "Nuovo fornitore")</button>
        </div>
    }
</div>

@if (_createError is not null)
{
    <div class="alert" role="alert">@_createError</div>
}
@if (_showCreate && CanCreate)
{
    <div class="card card-pad stack stack-gap">
        <h2>Nuovo fornitore</h2>
        <div class="form-grid">
            @foreach (var f in _fields.Where(f => f.Visible).OrderBy(f => f.Order))
            {
                switch (f.Key)
                {
                    case "name":
                        <label>@LabelOf(f)<input @bind="_newName" placeholder="Ragione sociale" /></label>
                        break;
                    case "code":
                        <label>@LabelOf(f)<input @bind="_newCode" placeholder="es. FOR-001" autocomplete="off" /></label>
                        break;
                    case "email":
                        <label>@LabelOf(f)<input @bind="_newEmail" placeholder="info@fornitore.it" /></label>
                        break;
                    case "phone":
                        <label>@LabelOf(f)<input @bind="_newPhone" placeholder="Telefono" /></label>
                        break;
                    case "website":
                        <label>@LabelOf(f)<input @bind="_newWebsite" placeholder="Sito web o catalogo" /></label>
                        break;
                }
            }
            @foreach (var f in _customFields.OrderBy(f => f.Order))
            {
                <label>@(f.Required ? f.Label + " *" : f.Label)
                    @switch (f.FieldType)
                    {
                        case "Number":
                            <input type="number" step="any" aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                        case "Date":
                            <input type="date" aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                        case "Checkbox":
                            <input type="checkbox" aria-label="@f.Label" checked="@CustomFieldChecked(f.Key)" @onchange="e => SetCustomFieldChecked(f.Key, e.Value)" />
                            break;
                        default:
                            <input aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                    }
                </label>
            }
        </div>
        <div class="actions"><button @onclick="CreateAsync" disabled="@_creating">@(_creating ? "Salvataggio..." : "Crea fornitore")</button></div>
    </div>
}

<div class="toolbar">
    <input class="search" type="search" placeholder="Nome o codice" aria-label="Filtra fornitori" @bind="_search" @bind:event="oninput" />
</div>

<div class="card">
    @if (_error is not null)
    {
        <div class="state"><strong>Impossibile caricare i fornitori</strong>@_error
            <div class="actions"><button class="secondary small" @onclick="LoadAsync">Riprova</button></div></div>
    }
    else if (_suppliers is null)
    {
        <div class="state">Caricamento...</div>
    }
    else if (Visible.Count == 0)
    {
        <div class="state"><strong>Nessun fornitore</strong>@(string.IsNullOrWhiteSpace(_search)
            ? CanCreate ? "Aggiungi il primo fornitore con il pulsante «Nuovo fornitore»." : "I fornitori si aggiungono dal programma desktop."
            : $"Nessun fornitore corrisponde a \"{_search}\".")</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cards">
                <thead><tr><th>Codice</th><th>Nome</th><th>Telefono</th><th>Email</th></tr></thead>
                <tbody>
                    @foreach (var supplier in Visible)
                    {
                        <tr class="link" @onclick="@(() => Nav.NavigateTo($"fornitori/{supplier.Id}"))">
                            <td data-label="Codice" class="code">@supplier.Code</td>
                            <td data-label="Nome">@supplier.Name</td>
                            <td data-label="Telefono" class="muted">@(supplier.Phone ?? "—")</td>
                            <td data-label="Email" class="muted">@(supplier.Email ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string _search = string.Empty;
    private List<Supplier>? _suppliers;
    private string? _error;
    private string? _createError;
    private bool _showCreate;
    private bool _creating;
    private string _newName = string.Empty;
    private string _newCode = string.Empty;
    private string _newEmail = string.Empty;
    private string _newPhone = string.Empty;
    private string _newWebsite = string.Empty;
    private List<CustomFieldDefinition> _customFields = [];
    private readonly Dictionary<string, string?> _customFieldValues = [];

    private string? CustomFieldValue(string key) => _customFieldValues.GetValueOrDefault(key);
    private void SetCustomField(string key, string? value) => _customFieldValues[key] = value;
    private bool CustomFieldChecked(string key) => bool.TryParse(_customFieldValues.GetValueOrDefault(key), out var value) && value;
    private void SetCustomFieldChecked(string key, object? value) => _customFieldValues[key] = value is true ? bool.TrueString : bool.FalseString;

    private bool CanCreate => Session.Role is "Admin" or "Purchasing";

    private List<Supplier> Visible => (_suppliers ?? [])
        .Where(s => string.IsNullOrWhiteSpace(_search)
            || s.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || s.Code.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(s => s.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadCreateLayoutAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _suppliers = null;
        try
        {
            _suppliers = await Api.GetAsync<List<Supplier>>("api/suppliers");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    /// <summary>Campi del modulo Nuovo fornitore come li ha impostati l'Admin nello strumento Layout.</summary>
    private List<LayoutField> _fields =
    [
        new("name", "Nome", 1, true, true, false),
        new("code", "Codice", 2, true, true, false),
        new("email", "Email", 3, true, false, true),
        new("phone", "Telefono", 4, true, false, true),
        new("website", "Sito web / catalogo", 5, true, false, true),
    ];

    private static string LabelOf(LayoutField f) => f.Required ? f.Label + " *" : f.Label;

    private async Task LoadCreateLayoutAsync()
    {
        try
        {
            _fields = (await Api.GetAsync<LayoutScreen>("api/layout/suppliers.new")).Fields;
        }
        catch (ApiException)
        {
            // Restano i default: il layout non deve impedire di creare fornitori.
        }

        try
        {
            _customFields = await Api.GetAsync<List<CustomFieldDefinition>>("api/layout/suppliers.new/custom-fields");
        }
        catch (ApiException)
        {
            // Nessun campo personalizzato, o non raggiungibile: il modulo resta con i soli campi standard.
        }
    }

    private async Task CreateAsync()
    {
        var missing = _fields.Where(f => f.Visible && f.Required && string.IsNullOrWhiteSpace(f.Key switch
            {
                "name" => _newName,
                "code" => _newCode,
                "email" => _newEmail,
                "phone" => _newPhone,
                "website" => _newWebsite,
                _ => null,
            })).Select(LabelOf).ToList();
        missing.AddRange(_customFields.Where(f => f.Required && string.IsNullOrWhiteSpace(CustomFieldValue(f.Key))).Select(f => f.Label));
        if (missing.Count > 0)
        {
            _createError = "Compila i campi obbligatori: " + string.Join(", ", missing) + ".";
            return;
        }
        _creating = true;
        _createError = null;
        try
        {
            var created = await Api.PostAsync<Supplier>("api/suppliers", new
            {
                name = _newName.Trim(),
                code = _newCode.Trim(),
                email = string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail.Trim(),
                phone = string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone.Trim(),
                website = string.IsNullOrWhiteSpace(_newWebsite) ? null : _newWebsite.Trim(),
                customFields = _customFieldValues,
            });
            _newName = string.Empty;
            _newCode = string.Empty;
            _newEmail = string.Empty;
            _newPhone = string.Empty;
            _newWebsite = string.Empty;
            _customFieldValues.Clear();
            _showCreate = false;
            Nav.NavigateTo($"fornitori/{created.Id}");
        }
        catch (ApiException exception)
        {
            _createError = exception.Message;
        }
        finally
        {
            _creating = false;
        }
    }
}
