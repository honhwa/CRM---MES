@page "/capa"
@inject Api Api
@inject Session Session

<PageTitle>CAPA · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Qualità</div>
        <h1>Azioni correttive (CAPA)</h1>
        <p class="sub">Gestione non conformità e azioni correttive/preventive.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert" role="alert">@_error</div>
}

<div class="card">
    @if (_capas is null)
    {
        <div class="state">@Labels.Loading</div>
    }
    else if (_capas.Count == 0)
    {
        <div class="state"><strong>Nessuna CAPA</strong>@(CanManage ? " Apri la prima azione correttiva qui sotto." : "")</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cards">
                <thead><tr><th>Codice</th><th>Titolo</th><th>Stato</th><th>Aperta</th><th>Scadenza</th><th></th></tr></thead>
                <tbody>
                    @foreach (var capa in _capas)
                    {
                        <tr>
                            <td data-label="Codice" class="code">@capa.Code</td>
                            <td data-label="Titolo">@capa.Title</td>
                            <td data-label="Stato"><span class="badge @StatusClass(capa.Status)">@StatusLabel(capa.Status)</span></td>
                            <td data-label="Aperta">@Labels.Date(capa.OpenedAt)</td>
                            <td data-label="Scadenza">@(capa.DueDate is null ? "—" : Labels.Date(capa.DueDate))</td>
                            <td>
                                @if (CanManage && capa.Status != "Closed")
                                {
                                    @if (capa.Status == "Open")
                                    {
                                        <button class="secondary small" @onclick='() => SetStatusAsync(capa.Id, "InProgress")'>Avvia</button>
                                    }
                                    <button class="secondary small" @onclick='() => SetStatusAsync(capa.Id, "Closed")'>Chiudi</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (CanManage)
{
    <div class="card card-pad stack">
        <h2>Nuova CAPA</h2>
        <div class="form-grid">
            @foreach (var f in _newFields.Where(f => f.Visible).OrderBy(f => f.Order))
            {
                switch (f.Key)
                {
                    case "code":
                        <label>@LayoutHelper.LabelOf(f)<input @bind="_newCode" placeholder="Auto se vuoto" autocomplete="off" /></label>
                        break;
                    case "title":
                        <label>@LayoutHelper.LabelOf(f)<input @bind="_newTitle" /></label>
                        break;
                    case "description":
                        <label>@LayoutHelper.LabelOf(f)<textarea @bind="_newDescription" rows="2"></textarea></label>
                        break;
                    case "dueDate":
                        <label>@LayoutHelper.LabelOf(f)<input type="date" @bind="_newDueDate" /></label>
                        break;
                }
            }
        </div>
        <div class="actions"><button @onclick="CreateAsync" disabled="@_busy">Crea CAPA</button></div>
    </div>
}

@code {
    private List<CapaRow>? _capas;
    private string? _error;
    private bool _busy;
    private string _newCode = string.Empty;
    private string _newTitle = string.Empty;
    private string _newDescription = string.Empty;
    private DateTime? _newDueDate;

    private bool CanManage => Session.Role is "Admin" or "Management";

    /// <summary>Campi del modulo come li ha impostati l'Admin nello strumento Layout (default prima della risposta).</summary>
    private List<LayoutField> _newFields =
    [
        new("code", "Codice (opzionale)", 1, true, false, true),
        new("title", "Titolo", 2, true, true, false),
        new("description", "Descrizione", 3, true, false, true),
        new("dueDate", "Scadenza", 4, true, false, true),
    ];

    private async Task LoadNewLayoutAsync()
    {
        try { _newFields = (await Api.GetAsync<LayoutScreen>("api/layout/capa.new")).Fields; }
        catch (ApiException) { /* restano i default */ }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNewLayoutAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _capas = await Api.GetAsync<List<CapaRow>>("api/capas");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        var missing = LayoutHelper.Missing(_newFields, key => key switch
        {
            "code" => _newCode,
            "title" => _newTitle,
            "description" => _newDescription,
            "dueDate" => _newDueDate?.ToString(),
            _ => null,
        });
        if (missing.Count > 0)
        {
            _error = "Compila i campi obbligatori: " + string.Join(", ", missing) + ".";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Api.PostAsync<CapaRow>("api/capas", new
            {
                code = string.IsNullOrWhiteSpace(_newCode) ? null : _newCode.Trim(),
                title = _newTitle.Trim(),
                description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
                dueDate = _newDueDate
            });
            _newCode = _newTitle = _newDescription = string.Empty;
            _newDueDate = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetStatusAsync(Guid id, string status)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.PutAsync<CapaRow>($"api/capas/{id}/status", new { status });
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        "InProgress" => "In corso",
        "Closed" => "Chiusa",
        _ => "Aperta"
    };

    private static string StatusClass(string status) => status switch
    {
        "Closed" => "ok",
        "InProgress" => "",
        _ => "warn"
    };
}
