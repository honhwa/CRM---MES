<Window x:Class="CrmMes.Desktop.LotMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distinta materiali" Icon="Assets/logo.ico" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="360" MinWidth="480"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="D I S T I N T A   M A T E R I A L I" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="SubtitleText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="StatusBanner" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4" Margin="0,14,0,0">
            <ListView x:Name="LinesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Materiale" DisplayMemberBinding="{Binding MaterialCode}" Width="180" />
                        <GridViewColumn Header="Previsto" DisplayMemberBinding="{Binding RequiredLabel}" Width="100" />
                        <GridViewColumn Header="Disponibile" DisplayMemberBinding="{Binding AvailableLabel}" Width="110" />
                        <GridViewColumn Header="Mancante" DisplayMemberBinding="{Binding ShortfallLabel}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Window>
