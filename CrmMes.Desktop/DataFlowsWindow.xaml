<Window x:Class="CrmMes.Desktop.DataFlowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flussi di dati" Icon="Assets/logo.ico" Height="820" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="620" MinWidth="820"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="A M M I N I S T R A Z I O N E" Style="{StaticResource MicroLabel}" />
            <TextBlock Text="Flussi di dati" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Quando succede un evento, avvisa un ruolo o fermati per un'approvazione. Versione 1: niente rami, niente azioni che toccano il magazzino." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Editor -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="18" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="EditorTitleText" Text="Nuovo flusso" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nome" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Evento che lo avvia" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="EventCombo" DisplayMemberPath="Name" SelectionChanged="EventCombo_SelectionChanged" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" x:Name="EnabledBox" Content="Attivo" VerticalAlignment="Bottom" Margin="0,0,0,8" IsChecked="True" />
                </Grid>

                <TextBlock x:Name="PlaceholdersText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Text="Passi, in ordine" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="4" MaxHeight="220">
                    <ListView x:Name="StepsList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tipo" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Type, Mode=TwoWay}" SelectionChanged="StepType_SelectionChanged">
                                                <ComboBoxItem Content="Avvisa ruolo" Tag="NotifyRole" />
                                                <ComboBoxItem Content="Richiedi approvazione" Tag="RequireApproval" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Ruolo" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding TargetRole, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Messaggio (se &quot;Avvisa ruolo&quot;)" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotifyRole}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Rimuovi" Style="{StaticResource SecondaryButton}" Height="26" Click="RemoveStep_Click" Tag="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Aggiungi passo" Style="{StaticResource SecondaryButton}" Width="140" Height="32" Margin="0,0,10,0" Click="AddStep_Click" />
                    <Button x:Name="SaveButton" Content="Crea flusso" Width="150" Height="32" Margin="0,0,10,0" Click="Save_Click" />
                    <Button x:Name="CancelEditButton" Content="Annulla modifica" Style="{StaticResource SecondaryButton}" Width="150" Height="32" Visibility="Collapsed" Click="CancelEdit_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Existing flows -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4" Margin="0,16,0,0">
            <ListView x:Name="FlowsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="220" />
                        <GridViewColumn Header="Evento" DisplayMemberBinding="{Binding EventName}" Width="220" />
                        <GridViewColumn Header="Passi" DisplayMemberBinding="{Binding StepsCount}" Width="70" />
                        <GridViewColumn Header="Stato" DisplayMemberBinding="{Binding StatusLabel}" Width="90" />
                        <GridViewColumn Header="" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Modifica" Style="{StaticResource SecondaryButton}" Height="26" Width="90" Margin="0,0,6,0" Click="EditFlow_Click" Tag="{Binding}" />
                                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButton}" Height="26" Width="90" Margin="0,0,6,0" Click="ToggleFlow_Click" Tag="{Binding}" />
                                        <Button Content="Elimina" Style="{StaticResource SecondaryButton}" Height="26" Width="90" Click="DeleteFlow_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
