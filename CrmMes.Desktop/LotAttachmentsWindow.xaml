<Window x:Class="CrmMes.Desktop.LotAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto del lotto" Icon="Assets/logo.ico" Height="620" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="560"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="F O T O   D E L   L O T T O" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="SubtitleText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Tipo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="KindCombo" SelectedIndex="0">
                        <ComboBoxItem Content="Controllo qualità" Tag="quality" />
                        <ComboBoxItem Content="Istruzioni operatore" Tag="instructions" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Didascalia (facoltativa)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="CaptionBox" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="UploadButton" Content="Scegli file e carica" Width="170" Height="30" VerticalAlignment="Bottom" Click="Upload_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AttachmentsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Width="170" Margin="0,0,10,10" Padding="8">
                                <StackPanel>
                                    <Image Source="{Binding Thumbnail}" Height="120" Stretch="Uniform" />
                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding CaptionVisibility}" />
                                    <TextBlock Text="{Binding UploadedLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6" TextWrapping="Wrap" />
                                    <Button Content="Elimina" Style="{StaticResource SecondaryButton}" Height="26" Click="DeleteAttachment_Click" Tag="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Window>
